{
  "name": "ftdc-lens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-native, zero-infrastructure viewer for MongoDB FTDC diagnostic data",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "oracle:build": "bash tools/oracle/build.sh",
    "fixtures": "bash tools/fixtures/generate.sh",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "inspect": "vite-node tools/inspect.ts",
    "catalogs": "vite-node tools/catalogs.ts",
    "fixtures:versions": "bash tools/fixtures/versions.sh",
    "fixtures:sharded": "bash tools/fixtures/sharded.sh",
    "units": "vite-node tools/units.ts",
    "verify:browser": "bash tools/browser/verify.sh"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^2.2.3",
    "uplot": "^1.6.32",
    "zustand": "^5.0.14"
  }
}
